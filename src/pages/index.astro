---
import Layout from "../layouts/Layout.astro"
import AboutMe from "../components/AboutMe.astro"
import Briefcase from "../components/icons/Briefcase.astro"
import CodeIcon from "../components/icons/Code.astro"
import Experience from "../components/Experience.astro"
import ProfileCheck from "../components/icons/ProfileCheck.astro"
import Projects from "../components/Projects.astro"
import Skills from "../components/Skills.astro"
import SectionContainer from "../components/SectionContainer.astro"
import Hero from "../components/Hero.astro"
import TitleSection from "../components/TitleSection.astro"
import SkillsIcon from "../components/icons/SkillsIcon.astro"
import Contact from "../components/Contact.astro"
---

<Layout
  title="David García | Desarrollador Full Stack en Barcelona"
  description="Porfolio de David García, desarrollador Full Stack en Barcelona. Experiencia, proyectos y CV."
>
  <main class="px-4">
    <SectionContainer id="inicio" class="pt-24 pb-16 md:pt-36 md:pb-28" animate={false}>
      <Hero />
    </SectionContainer>

    <div class="space-y-28">
      <SectionContainer id="experiencia">
        <TitleSection>
          <Briefcase class="size-7" />
          Experiencia laboral
        </TitleSection>
        <Experience />
      </SectionContainer>

      <SectionContainer id="proyectos">
        <TitleSection>
          <CodeIcon class="size-7" />
          Proyectos
        </TitleSection>
        <Projects />
      </SectionContainer>

      <SectionContainer id="skills">
        <TitleSection>
          <SkillsIcon class="size-7" />
          Skills
        </TitleSection>
        <Skills />
      </SectionContainer>

      <SectionContainer id="sobre-mi">
        <TitleSection>
          <ProfileCheck class="size-7" />
          Sobre mí
        </TitleSection>
        <AboutMe />
      </SectionContainer>

      <SectionContainer id="contacto">
        <Contact />
      </SectionContainer>
    </div>
  </main>
</Layout>
