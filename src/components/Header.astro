---
import ThemeToggle from "./ThemeToggle.astro"

const navItems = [
  {
    title: "Experiencia",
    label: "experiencia",
    url: "/#experiencia",
  },
  {
    title: "Proyectos",
    label: "proyectos",
    url: "/#proyectos",
  },
  {
    title: "Skills",
    label: "skills",
    url: "/#skills",
  },
  {
    title: "Sobre mí",
    label: "sobre-mi",
    url: "/#sobre-mi",
  },
]
---

<header
  class="fixed top-0 z-10 flex items-center justify-center w-full mx-auto mt-2"
>
  <nav
    class="flex px-2 text-[13px] sm:px-3 sm:text-sm font-medium rounded-full text-gray-600 dark:text-gray-200 justify-center items-center"
  >
    {
      navItems.map((link) => (
        <a
          class="relative block whitespace-nowrap px-1 py-2 transition sm:px-2 hover:text-sky-700 dark:hover:text-sky-400"
          aria-label={link.label}
          href={link.url}
        >
          {link.title}
        </a>
      ))
    }
    <a
      href="/cv.pdf"
      download="CV David García.pdf"
      class="mx-1 rounded-full bg-gray-900 px-3 py-1 text-white transition hover:bg-gray-700 dark:bg-white dark:text-black dark:hover:bg-gray-200"
    >
      CV
    </a>
    <ThemeToggle />
  </nav>
</header>

<script>
  // Marca en el menú la sección que cruza la franja central de la pantalla
  const links = document.querySelectorAll<HTMLAnchorElement>("header nav a[aria-label]")
  const ACTIVE = ["text-sky-700", "dark:text-sky-400"]

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return
        links.forEach((link) => {
          const active = link.getAttribute("aria-label") === entry.target.id
          link.classList.toggle(ACTIVE[0], active)
          link.classList.toggle(ACTIVE[1], active)
          if (active) link.setAttribute("aria-current", "true")
          else link.removeAttribute("aria-current")
        })
      })
    },
    { rootMargin: "-45% 0px -50% 0px" }
  )

  document.querySelectorAll("main section[id]").forEach((section) => observer.observe(section))
</script>

<style>
  nav {
    animation: nav-shadown 1s linear both;
    animation-timeline: scroll();
    animation-range: 0 100px;
  }

  nav {
    @apply dark:bg-gray-800/90 bg-white/50;
  }

  @keyframes nav-shadown {
    /* parte transparente y termina en el fondo propio de la barra */
    from {
      background-color: transparent;
    }
    to {
      @apply shadow-lg ring-1 backdrop-blur ring-white/10;
    }
  }
</style>
