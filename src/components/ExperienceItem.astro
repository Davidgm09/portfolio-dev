---
import LinkInline from "./LinkInline.astro"
import HTML from "./icons/HTML.astro"
import CSS from "./icons/CSS.astro"
import PHP from "./icons/PHP.astro"
import SQL from "./icons/SQL.astro"
import JS from "./icons/JS.astro"

const TAGS = {
  HTML: { name: "HTML5", class: "bg-orange-400 text-black", icon: HTML },
  CSS: { name: "CSS3", class: "bg-sky-300 text-black", icon: CSS },
  PHP: { name: "PHP", class: "bg-black text-white", icon: PHP },
  SQL: { name: "MySQL", class: "bg-gray-300 dark:bg-white dark:text-black", icon: SQL },
  JS: { name: "JavaScript", class: "bg-white text-black", icon: JS },
}

interface Props {
  title: string
  company: string
  description: string
  tags?: any[]
  link?: string
  date: string
}

const { title, company, description, tags, link, date } = Astro.props
---

<div
  class="relative mx-12 pb-12 grid before:absolute before:left-[-35px] before:block before:h-full before:border-l-2 before:border-black/20 dark:before:border-white/15 before:content-[''] md:grid-cols-5 md:gap-10 md:space-x-4]"
>
  <div class="relative pb-12 md:col-span-2">
    <div class="sticky top-0">
      <span class="text-blue-500 -left-[42px] absolute rounded-full text-5xl">&bull;</span>
      <h3 class="text-xl font-bold text-blue-500">{title}</h3>
      <h4 class="font-semibold text-xl text-gray-600 dark:text-white">{company}</h4>
      <time class="p-0 m-0 text-sm text-gray-600/80 dark:text-white/80">{date}</time>
    </div>
  </div>

  <div class="relative flex flex-col gap-2 pb-4 text-gray-600 dark:text-gray-300 md:col-span-3">
    {description}
    {tags && tags.length > 0 && (
      <ul class="flex flex-wrap mb-2 gap-x-2 gap-y-2 mt-1">
        {tags.map((tag) => (
          <li>
            <span class={`flex gap-x-2 rounded-full text-xs ${tag.class} py-1 px-2`}>
              <tag.icon class="size-4" />
              {tag.name}
            </span>
          </li>
        ))}
      </ul>
    )}

    {link && (
      <LinkInline href={link}>
        Saber más{" "}
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="w-5 icon icon-tabler icon-tabler-chevron-right"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          stroke-width="2"
          stroke="currentColor"
          fill="none"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path stroke="none" d="M0 0h24v24H0z" fill="none" />
          <path d="M9 6l6 6l-6 6" />
        </svg>
      </LinkInline>
    )}
  </div>
</div>

