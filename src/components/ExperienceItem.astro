---
import LinkInline from "./LinkInline.astro"
import TagList from "./TagList.astro"
import type { Tag } from "../data/tags"

interface Props {
  title: string
  company: string
  description: string
  tags?: Tag[]
  link?: string
  date: string
}

const { title, company, description, tags, link, date } = Astro.props
---

<div
  class="relative grid gap-3 pb-12 pl-8 before:absolute before:left-[5px] before:top-2 before:h-full before:border-l-2 before:border-black/10 before:content-[''] md:grid-cols-5 md:gap-10 dark:before:border-white/15"
>
  <span
    class="absolute left-0 top-1.5 size-3 rounded-full bg-sky-600 dark:bg-sky-400"
    aria-hidden="true"
  ></span>

  <div class="md:col-span-2">
    <h3 class="text-lg font-bold leading-snug text-sky-700 dark:text-sky-400">{title}</h3>
    <p class="mt-1 font-semibold text-gray-800 dark:text-white">{company}</p>
    <time class="text-sm text-gray-500 dark:text-gray-400">{date}</time>
  </div>

  <div class="flex flex-col gap-3 text-pretty text-gray-700 md:col-span-3 dark:text-gray-300">
    <p>{description}</p>
    {tags && tags.length > 0 && <TagList tags={tags} />}
    {link && (
      <LinkInline href={link}>
        Ver empresa en LinkedIn
      </LinkInline>
    )}
  </div>
</div>
