---
import TailwindCSS from "./icons/TailwindCSS.astro"
import AIcon from "./icons/AIcon.astro"

const currentYear = new Date().getFullYear()
---

<footer class="mt-16 mb-10 w-full px-4">
  <div
    class="container mx-auto flex flex-col gap-4 py-4 text-sm text-gray-600 md:max-w-2xl md:flex-row md:items-center md:justify-between lg:max-w-4xl dark:text-gray-400"
  >
    <p>
      © {currentYear}
      <a
        href="https://www.linkedin.com/in/david-garcia-marmol-96854229b/"
        target="_blank"
        rel="noopener noreferrer"
        class="font-medium text-gray-800 hover:underline dark:text-gray-200">David García</a
      >
    </p>
    <ul class="flex flex-wrap items-center gap-2 font-medium">
      <li class="me-2">Desarrollado con</li>
      <li class="flex items-center gap-2 rounded-full bg-gray-200 px-3 py-1.5 text-gray-800 dark:bg-gray-900 dark:text-gray-200">
        <AIcon class="size-4" />
        Astro
      </li>
      <li class="flex items-center gap-2 rounded-full bg-gray-200 px-3 py-1.5 text-gray-800 dark:bg-gray-900 dark:text-gray-200">
        <TailwindCSS class="size-4" />
        Tailwind CSS
      </li>
    </ul>
  </div>
</footer>
