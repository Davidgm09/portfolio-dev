---
import { Image } from "astro:assets"
import { PROJECTS } from "../data/projects"
import TagList from "./TagList.astro"
import LinkButton from "./LinkButton.astro"
import Link from "./icons/Link.astro"
import Video from "./icons/Video.astro"
---

<div class="mt-12 flex flex-col gap-16">
  {
    PROJECTS.map(({ image, title, description, tags, link, video }) => (
      <article data-aos="fade-up" class="grid gap-6 md:grid-cols-2 md:gap-10 md:items-center">
        <a
          href={link ?? video}
          target="_blank"
          rel="noopener noreferrer"
          tabindex="-1"
          aria-hidden="true"
          class="block overflow-hidden rounded-xl border border-gray-200 bg-[#eceef4] shadow-lg dark:border-gray-800 dark:bg-gray-900"
        >
          <Image
            src={image}
            alt=""
            widths={[480, 800, 1200]}
            sizes="(min-width: 768px) 420px, 100vw"
            class="aspect-[16/10] w-full object-cover object-top transition duration-500 hover:scale-[1.03] motion-reduce:transition-none"
          />
        </a>

        <div class="flex flex-col gap-4">
          <h3 class="text-xl font-bold tracking-tight text-gray-900 md:text-2xl dark:text-white">
            {title}
          </h3>
          <TagList tags={tags} />
          <p class="text-pretty text-gray-700 dark:text-gray-300">{description}</p>
          <div class="flex flex-wrap gap-3">
            {link && (
              <LinkButton href={link}>
                <Link class="size-4" />
                Ver web
              </LinkButton>
            )}
            {video && (
              <LinkButton href={video}>
                <Video class="size-4" />
                Ver vídeo
              </LinkButton>
            )}
          </div>
        </div>
      </article>
    ))
  }
</div>
