---
import ExperienceItem from "./ExperienceItem.astro"
import HTML from "./icons/HTML.astro"
import CSS from "./icons/CSS.astro"
import PHP from "./icons/PHP.astro"
import SQL from "./icons/SQL.astro"
import JS from "./icons/JS.astro"
import NextJS from "./icons/NextJS.astro"
import ReactIcon from "./icons/React.astro"
import Tailwind from "./icons/TailwindCSS.astro"
import Azure from "./icons/Azure.astro"
import Moodle from "./icons/Moodle.astro"

const TAGS = {
    HTML: {
    name: "HTML5",
    class: "bg-orange-400 text-black",
    icon: HTML,
  },

  CSS: {
    name: "CSS3",
    class: "bg-sky-300 text-black",
    icon: CSS,
  },

  PHP: {
    name: "PHP",
    class: "bg-black text-white",
    icon: PHP,
  },

  SQL: {
    name: "MySQL",
    class: "bg-blue-100 text-blue-900",
    icon: SQL,
  },
  JS: {
    name: "JavaScript",
    class: "bg-yellow-200 text-black",
    icon: JS,
  },
  NEXT: {
    name: "Next.js",
    class: "bg-black text-white",
    icon: NextJS,
  },
  REACT: {
    name: "React",
    class: "bg-[#003159] text-white",
    icon: ReactIcon,
  },
  TAILWIND: {
    name: "Tailwind CSS",
    class: "bg-cyan-100 text-cyan-900",
    icon: Tailwind,
  },
  AZURE: {
    name: "Azure",
    class: "bg-indigo-100 text-indigo-900",
    icon: Azure,
  },
  MOODLE: {
    name: "Moodle",
    class: "bg-orange-100 text-orange-900",
    icon: Moodle,
  },
}
const EXPERIENCE = [
  {
    date: "Julio 2026",
    title: "Responsable de Informática de Gestión y Sistemas de Información",
    company: "BAU, Centre Universitari d'Arts i Disseny",
    description:
      "Encargado de la gestión de usuarios con Microsoft Azure, la administración de la plataforma Moodle, la gestión del campus virtual de la universidad y el mantenimiento de sus webs. Además, desarrollé la aplicación interna de gestión académica: notas de alumnos, profesorado, asignación docente y más.",
    tags: [TAGS.NEXT, TAGS.REACT, TAGS.TAILWIND, TAGS.AZURE, TAGS.MOODLE],
    link: "https://www.linkedin.com/school/bau-centre-universitari-darts-i-disseny/",
  },
  {
    date: "Octubre 2025",
    title: "Full Stack Developer",
    company: "Soccer System Pro",
    description:
      "Desarrollador web Full Stack en Soccer System Pro, trabajando en la creación y optimización de aplicaciones web.",
      tags: [TAGS.HTML, TAGS.CSS, TAGS.PHP,TAGS.SQL,TAGS.JS],
    link: "https://www.linkedin.com/company/soccersystempro/",

  },
  {
    date: "Febrero 2024",
    title: "Entrenador Docente de Informática y Comunicaciones",
    company: "MasterD",
    description:
      "Entrenador docente en el centro de formación ITMD (Instituto Tecnológico Master.D) de Barcelona, formando y capacitando a los alumnos en las áreas de Informática y Comunicaciones como en las áreas de Videojuegos.",
    link: "https://www.linkedin.com/school/master-d/",
  },
  {
    date: "Septiembre 2021",
    title: "Prácticas de Empresa",
    company: "MasterD",
    description:
      "Prácticas de empresa en Master D, encargado de ayudar a los alumnos de informática mientras desarrollaba manuales.",
  },
  {
    date: "Junio 2020",
    title: "Prácticas de Empresa",
    company: "Everis",
    description:
      "Participé en diferentes proyectos donde adquirí conocimientos técnicos, también de organización y gestión en equipo.",
  },
]
---

<ol class="relative mt-16">
  {
    EXPERIENCE.map((experience) => (
      <li class="">
        <ExperienceItem {...experience} />
      </li>
    ))
  }
</ol>
