---
import Rocket from "./icons/Rocket.astro"
import Office from "./icons/Office.astro"
import Cart from "./icons/Cart.astro"
import World from "./icons/World.astro"
import Wordpress from "./icons/Wordpress.astro"

const GIGS = [
  {
    icon: World,
    title: "-Desarrollo Web Moderno",
    services: [
      {
        icon: Rocket,
        title: "Landing page moderna",
        description: "Una página de una sola sección, rápida y enfocada en captar clientes.",
        price: "Desde 150 €"
      },
      {
        icon: Office,
        title: "Web corporativa",
        description: "Sitio web completo para empresas o profesionales, varias secciones.",
        price: "Desde 300 €"
      },
      {
        icon: Cart,
        title: "Tienda online básica",
        description: "E-commerce con carrito, productos, y pasarela de pagos.",
        price: "Desde 500 €"
      }
    ]
  },
  {
    icon: Wordpress,
    title: "-Diseño y Programación en WordPress",
    services: [
      {
        icon: Office,
        title: "Sitio WordPress",
        description: "Página de empresa, blog o portafolio usando WordPress personalizado.",
        price: "Desde 200 €"
      },
      {
        icon: Cart,
        title: "Tienda WooCommerce",
        description: "Tienda online profesional construida en WordPress + WooCommerce.",
        price: "Desde 450 €"
      },
      {
        icon: Rocket,
        title: "Optimización WordPress",
        description: "Mejora de velocidad, seguridad y SEO para tu sitio WordPress.",
        price: "Desde 150 €"
      }
    ]
  }
]
---

<section id="servicios" class="mt-16">
  {GIGS.map(({ title, icon: Icon, services }) => (
  <div class="mb-16">
    <h3
      class="text-2xl font-bold mb-8 flex items-center gap-3 opacity-0 translate-y-12 fade-in-up"
      style="animation-delay: 150ms; animation-duration: 1.2s;"
    >
      {title}
      <Icon class="w-10 h-10 mb-1" />
    </h3>

    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6 mt-8">
      {services.map(({ icon: Icon, title, description, price }, index) => (
      <div
      class="p-6 flex flex-col justify-between text-center rounded-lg bg-[#eceef4] dark:bg-gray-900 transition-transform transform hover:scale-105 hover:bg-gray-300 dark:hover:bg-gray-700 opacity-0 translate-y-12 fade-in-up"
      style={`animation-delay: ${index * 200}ms; animation-duration: ${1.3 + index * 0.2}s; animation-fill-mode: forwards;`}
    >
      <Icon class="object-cover mx-auto w-24 h-24 transition-transform duration-300" />
      <h4 class="text-black dark:text-white text-[18px] mt-[1rem] font-[600] border-b-2 border-gray-800 dark:border-white">
        {title}
      </h4>
      <p class="text-sm text-gray-700 dark:text-gray-300 mt-2 mb-2 min-h-[60px]">{description}</p>
      <p class="text-lg text-sky-400 dark:text-sky-500 font-bold">{price}</p>
    </div>

      ))}
    </div>
  </div>
))}

  <div class="text-center mt-12 opacity-0 translate-y-12 fade-in-up" style="animation-delay: 700ms; animation-duration: 1.3s;">
    <a
      href="#"
      target="_blank"
      rel="noopener noreferrer"
      class="inline-block bg-blue-500 hover:bg-blue-600 hover:scale-105 transition-all text-white px-10 py-3 rounded-2xl font-semibold text-lg"
    >
      Solicita tu web personalizada
    </a>
  </div>
</section>
