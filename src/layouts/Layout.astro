---
import "@fontsource-variable/onest"

import Header from "../components/Header.astro"
import Footer from "../components/Footer.astro"
import "../styles/global.css"
import "aos/dist/aos.css"
import Analytics from "@vercel/analytics/astro"

interface Props {
  title: string
  description: string
}

const { description, title } = Astro.props

// Las URL absolutas (canonical y vista previa en redes) necesitan `site` en astro.config.mjs
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined
const ogImage = Astro.site ? new URL("/og.png", Astro.site).href : undefined
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="David García" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {canonical && <link rel="canonical" href={canonical} />}

    <!-- Vista previa al compartir el enlace (LinkedIn, WhatsApp, X...) -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && <meta property="og:image:width" content="1200" />}
    {ogImage && <meta property="og:image:height" content="630" />}
    <meta name="twitter:card" content="summary_large_image" />

    <meta name="generator" content={Astro.generator} />

    <!-- Aplica el tema antes de pintar la página para evitar el parpadeo -->
    <script is:inline>
      try {
        const theme = localStorage.getItem("theme") ?? "system"
        const dark =
          theme === "dark" ||
          (theme === "system" && window.matchMedia("(prefers-color-scheme: dark)").matches)
        document.documentElement.classList.toggle("dark", dark)
      } catch {}
    </script>
  </head>
  <body class="relative overflow-x-hidden text-black dark:text-white">
    <div
      class="absolute top-0 bottom-0 z-[-2] min-h-screen w-full bg-gray-50 dark:bg-gray-950
      bg-[radial-gradient(ellipse_80%_80%_at_50%_-20%,rgba(217,216,255,0.5),rgba(255,255,255,0.9))]
      dark:bg-[radial-gradient(ellipse_80%_80%_at_50%_-20%,rgba(120,119,198,0.3),rgba(255,255,255,0))]"
    >
    </div>
    <Header />
    <slot />
    <Footer />
    <!-- Estadísticas de visitas de Vercel (sin cookies) -->
    <Analytics />
    <style is:global>
      :root {
        color-scheme: light;
      }

      :root.dark {
        color-scheme: dark;
      }

      html {
        font-family: "Onest Variable", system-ui, sans-serif;
        scroll-behavior: smooth;
      }

      body {
        color: rgba(17, 17, 17, 0.9);
        display: flex;
        flex-direction: column;
        min-height: 100vh;
        overscroll-behavior: none;
      }

      @media (prefers-reduced-motion: reduce) {
        html {
          scroll-behavior: auto;
        }
      }

      html.dark body {
        color: rgba(255, 255, 255, 0.9);
      }
    </style>
    <script>
      import AOS from "aos"

      // Animaciones de aparición al hacer scroll (desactivadas si se prefiere menos movimiento)
      AOS.init({
        duration: 800,
        easing: "ease-in-out",
        once: true,
        offset: 100,
        disable: () => window.matchMedia("(prefers-reduced-motion: reduce)").matches,
      })
    </script>
  </body>
</html>
